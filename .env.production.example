SECRET_KEY=replace-with-long-random-value
APP_DOMAIN=shortly.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=shortly
POSTGRES_USER=shortly
POSTGRES_PASSWORD=change-this-password

DATABASE_URL=postgresql://shortly:change-this-password@db:5432/shortly
REDIS_URL=redis://redis:6379/0

ENABLE_ASYNC_CLICKS=true
CLICK_QUEUE_NAME=shortly:click-events
RATE_LIMIT_DEFAULT=300 per minute
